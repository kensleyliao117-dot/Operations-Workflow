DATABASE_URL=postgresql+psycopg://postgres:replace-me@localhost:5432/Operations
# 留空时使用同一服务器的 OperationsMemory；禁止指向业务库本身。
MEMORY_DATABASE_URL=
# 使用密码生成器生成至少 32 字节的独立随机密钥。
JWT_SECRET_KEY=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 相对路径以项目根目录为基准；也支持绝对路径，例如 D:/OperationsData/uploads。
UPLOAD_DIR=storage/uploads
DEEPSEEK_API_KEY=
# 用户模型凭据的独立 Fernet 加密密钥；留空时首次保存生成 storage/secrets/model-credentials.key。
# 部署多实例需配置相同密钥；备份数据库时同时安全备份密钥，不能提交到 Git。
MODEL_CREDENTIALS_KEY=
DEEPSEEK_URL=https://api.deepseek.com
# 文本生成模型，与 EMBEDDING_MODEL 独立配置。
DEEPSEEK_MODEL=deepseek-flash
DASHSCOPE_API_KEY=
DASHSCOPE_URL=
DASHSCOPE_MODEL=
# 千问同步文生图，独立于聊天和向量配置；Key 留空时沿用 DASHSCOPE_API_KEY。
QWEN_IMAGE_API_KEY=
QWEN_IMAGE_MODEL=qwen-image-2.0
QWEN_IMAGE_BASE_URL=https://dashscope.aliyuncs.com
QWEN_IMAGE_TIMEOUT_SECONDS=180
# 入库和查询共用以下向量配置，不读取 DASHSCOPE_MODEL / DASHSCOPE_URL。
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BATCH_SIZE=10
# 可选独立 Key，留空时使用 DASHSCOPE_API_KEY。
EMBEDDING_API_KEY=
# 可选：仅填写已确认与上述模型匹配的 tokenizer.json，相对路径基于项目目录。
EMBEDDING_TOKENIZER_PATH=
EMBEDDING_TOKENIZER_MODEL=
# Chrome 以独立用户目录启用远程调试后，连接本机 CDP。
CHROME_CDP_URL=http://127.0.0.1:9222
CHROME_CDP_TIMEOUT_MS=10000
CHROME_PAGE_TIMEOUT_MS=30000
